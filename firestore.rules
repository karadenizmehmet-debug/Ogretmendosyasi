rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Yalnızca dosya sahibi (Mehmet Karadeniz) okur ve yazar.
    match /{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == 'i4jvgGhne2a5LLyZpvTlVZnraGJ3';
    }
  }
}
