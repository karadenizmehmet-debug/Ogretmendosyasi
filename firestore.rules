rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Herkes okur, yalnızca dosya sahibi (Mehmet Karadeniz) yazar.
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == 'i4jvgGhne2a5LLyZpvTlVZnraGJ3';
    }
  }
}
